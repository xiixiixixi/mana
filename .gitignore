# Secrets — API keys live in the macOS Keychain. This file (if present) holds
# only non-secret metadata, but is ignored defensively (and covers the legacy
# plaintext format + the migration backup).
.keys.json
.keys.json.*

# Dependencies
node_modules/

# Logs
*.log

# Local env
.env*

# macOS
.DS_Store
**/.DS_Store

# 工具临时目录
.omo/
.playwright-mcp/

# 本地个人配置（通知阈值/菜单栏设置）
.config.json

# 编辑器/构建临时文件
*.tmp
*.bak
*.swp
*~

# 构建产物
src-swift/build/
src-swift/icons/AppIcon.iconset/
src-swift/icons/icon-1024.png

# 竞品参考代码（不属于本项目）
竞品TokenBar/

# 设计系统文件包（个人复用，不入库）
design/

# GitHub OAuth 应用配置（本机个人文件，构建时打包进 app；client_id 虽非密钥，仍不入库）
.github-oauth.json

# 研究工具临时目录
.sleuth-tmp/

# DMG 产物（防止被复制到根目录后误传）
*.dmg
